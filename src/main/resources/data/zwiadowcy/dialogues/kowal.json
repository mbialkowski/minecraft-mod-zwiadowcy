    "witaj": {
      "text": "Hej, młody! Uważaj na iskry. Kuję podkowy dla stajni barona i groty dla łuczników. Masz coś do naprawy?",
      "options": [
        {
          "text": "Napraw to, co trzymam w dłoni.",
