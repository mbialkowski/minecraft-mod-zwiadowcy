            {
              "cooldown_active": "kowal",
              "ticks": 24000
            }
          ],
          "next": "zajety"
        },
        {
          "text": "Co wiesz o broni Wargalów?",
          "next": "wargale"
        },
        {
          "text": "Nie przeszkadzam."
        }
      ]
    },
    "naprawa": {
      "text": "Gotowe. Jak nowe. Dobra robota zasługuje na dobrą stal.",
      "options": [
        {
          "text": "Dziękuję!",
          "next": "witaj"
        }
      ]
    },
    "zajety": {
      "text": "Dzisiaj już nie dam rady, palenisko ledwie dyszy, a baron chce sto podków na jutro. Przyjdź rano.",
      "options": [
        {
          "text": "Rozumiem.",
          "next": "witaj"
        }
      ]
    },
    "wargale": {
      "text": "Prymitywna, ale groźna. Toporzyska z jesionu, ostrza z kradzionego żelaza, oszczepy z utwardzanym w ogniu grotem. Jak przyniesiesz mi topór ich herszta, chętnie go obejrzę. Słyszałem, że to kawał porządnej stali - pewnie zrabowanej.",
      "options": [
        {
          "text": "Zapamiętam.",
          "next": "witaj"
        }
      ]
    },
    "t2_zapasy": {
      "text": "Crowley kazał przygotować wam zapasy. Strzały, olej i racje na drogę. Nie pytam, po co zwiadowcom tyle oleju. Lepiej nie wiedzieć.",
      "options": [
        {
          "text": "Dziękuję!",
